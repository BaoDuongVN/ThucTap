<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update user</title>
    <link rel="stylesheet" href="/css/update.css">
</head>
<body>
    <div class="form-container">
        <h1>Update User</h1>
        <form action="/update" method="POST">
            <div class="form-group">
                <label for="id">User ID</label>
                <input type="text" id="id" name="id" value="<%= userList.id %>" readonly>
            </div>
    
            <div class="form-group">
                <label for="email">Email address</label>
                <input type="text" id="email" name="email" value="<%= userList.email %>" placeholder="Enter your new email" required>
            </div>
    
            <div class="form-group">
                <label for="name">User name</label>
                <input type="text" id="name" name="name" value="<%= userList.name %>" placeholder="Enter your new name" required>
            </div>
    
            <div class="form-group">
                <label for="city">City</label>
                <input type="text" id="city" name="city" value="<%= userList.city %>" placeholder="Enter your new city" required>
            </div>
    
            <button type="submit" class="btn-submit">Submit</button>
        </form>
    </div>
</body>
</html>