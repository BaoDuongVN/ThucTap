<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="/css/style2.css">
</head>

<body>
    <div class="topnav">
        <a class="active" href="#home">Home</a>
        <a href="/create">Create User</a>
    </div>

    <div class="table-container">
        <div class="title">List Users</div>

        <table>
            <tr>
              <th>ID</th>
              <th>Email</th>
              <th>Name</th>
              <th>City</th>
              <th>Actions</th>
            </tr>

            <!-- <% for (let i = 0; i < listUsers.length; i++) { %>

            
              <tr>
                <td><%= listUsers[i].id %></td>
                <td><%= listUsers[i].email %></td>
                <td><%= listUsers[i].name %></td>
                <td><%= listUsers[i].city %></td>
                <td>
                  <button>Edit</button>
                  <button>Delete</button>
                </td>
              </tr>
            <% } %> -->

            <% listUsers.forEach( (user, index) => { %>
              <tr>
                <td><%= user.id %></td>
                <td><%= user.email %></td>
                <td><%= user.name %></td>
                <td><%= user.city %></td>
                <td>
                  <div class="user-actions">
                    <a href="/update/<%= user.id %>" class="btn edit-btn">Edit</a>
                  
                    <form action="/delete-user/<%= user.id %>" method="POST" class="delete-form">
                      <button type="submit" class="btn delete-btn" onclick="return confirm('Are you sure you want to delete this user?')">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </table>
    </div>
</body>
</html>